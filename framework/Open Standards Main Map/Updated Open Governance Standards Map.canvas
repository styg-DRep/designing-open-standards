		{"id":"3589859348dacad6","type":"text","text":"When important actors, relationships, infrastructure, standards, control points, or dependencies are still poorly understood","x":4815,"y":-2828,"width":420,"height":84,"color":"3"},
		{"id":"5fee9163c27fc97c","type":"text","text":"When the intended change is unclear, objectives conflict, or the proposed standard no longer plausibly supports the stated aim","x":4815,"y":-2745,"width":420,"height":84,"color":"3"},
		{"id":"01b47a62cc5a0e0d","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Frame the Opportunity.md","x":5400,"y":-2901,"width":400,"height":63,"color":"4"},
