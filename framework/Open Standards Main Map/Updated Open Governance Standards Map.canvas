		{"id":"011769c6cd5f8c87","type":"text","text":"When reuse, extension, interoperability, or “use something else” questions remain unresolved","x":4815,"y":-2574,"width":420,"height":84,"color":"3"},
		{"id":"72ed595d8f71f75d","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Identify Current Ecosystem Standards.md","x":5400,"y":-2571,"width":400,"height":81,"color":"4"},
		{"id":"207ea5acb1ae11ac","type":"text","text":"When participation is too narrow, representation gaps are material, or there are no credible shapers/testers/early adopters","x":4815,"y":-2490,"width":420,"height":84,"color":"3"},
		{"id":"a70fd1ff98e43b4c","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Identify Community Stakeholders.md","x":5400,"y":-2481,"width":400,"height":66,"color":"4"},
