		{"id":"fe70ce56d2cd7980","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Decide On Aims and Objectives.md","x":2660,"y":-2045,"width":400,"height":105,"color":"6"},
		{"id":"7a6002f3047f7b1c","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Development Principles.md","x":2924,"y":-1782,"width":273,"height":84,"color":"2"},
		{"id":"077580fc238e8652","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Sustainability Gate.md","x":3787,"y":-1420,"width":250,"height":78,"color":"1"},
		{"id":"aa9203593b939f9a","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/1- Choose the Development Method.md","x":2965,"y":-1383,"width":320,"height":82,"color":"4"},
		{"id":"cd972e0afd014026","type":"text","text":"in exceptional cases where implementation evidence exposes a faulty original premise","x":5290,"y":-3579,"width":410,"height":50,"color":"3"},
		{"id":"c6d00188a9c04a33","type":"file","file":"framework/Open Standards Main Map/Phase 1 Scope and Start/Decide On Aims and Objectives.md","x":5900,"y":-3604,"width":400,"height":75,"color":"4"},
		{"id":"e931168427573d83","type":"text","text":"`returns-to` instances\n","x":4925,"y":-3539,"width":250,"height":60,"color":"3"},
		{"id":"521c94420e8b8de6","type":"text","text":"for comprehension or implementation guidance defects","x":5290,"y":-3680,"width":410,"height":50,"color":"3"},
		{"id":"448cd4920f6cd82d","type":"file","file":"framework/Open Standards Main Map/Phase 2 Development/Documentation.md","x":5900,"y":-3679,"width":400,"height":50,"color":"5"},
		{"id":"e157b50d7c17b5b0","type":"text","text":"if evidence reveals the standard cannot plausibly achieve an objective","x":5290,"y":-3629,"width":410,"height":50,"color":"3"},
		{"id":"6c84b215a512a81f","type":"text","text":"When testing reveals that an intended use case is impossible","x":7260,"y":-7329,"width":460,"height":90,"color":"3"},
		{"id":"f38d75b7219512d4","type":"text","text":"When implementers reveal that another existing standard solves the issue","x":7260,"y":-7219,"width":460,"height":90,"color":"3"},
		{"id":"412ea059ba92cbb8","type":"text","text":"When a new affected group becomes visible","x":7260,"y":-7109,"width":460,"height":90,"color":"3"},
		{"id":"2a78cc0014c814f2","type":"text","text":"When the standard's adoption burden becomes unsustainable","x":7260,"y":-6999,"width":460,"height":90,"color":"3"},
		{"id":"45322b2eb3892920","type":"text","text":"When specification defects remain, important features are incomplete, or major ambiguities remain","x":7260,"y":-6729,"width":460,"height":90,"color":"3"},
		{"id":"120eccc0528629cc","type":"text","text":"When evidence is too weak, interoperability is unproven, important scenarios are unexercised, or regression confidence is insufficient","x":7260,"y":-6619,"width":460,"height":90,"color":"3"},
		{"id":"061a1e5717825a62","type":"text","text":"When implementation needs author assistance, normative and informative material conflict, key audiences cannot use the standard, or examples are inadequate","x":7260,"y":-6509,"width":460,"height":90,"color":"3"},
		{"id":"97f7772b2e23ef62","type":"text","text":"When critical responsibilities are unfilled, editorial or testing capacity is insufficient, decision authority is unclear, or development depends on one person","x":7260,"y":-6399,"width":460,"height":90,"color":"3"},
		{"id":"d1c1681d113dbcb5","type":"text","text":"When provenance is incomplete, decisions cannot be traced, tests or releases cannot be reproduced, or artifacts are fragmented","x":7260,"y":-6289,"width":460,"height":90,"color":"3"},
		{"id":"19d8a255d1f32acb","type":"text","text":"When stakeholders have not seen the candidate, review windows were insufficient, changes were not communicated, or feedback remains ungathered","x":7260,"y":-6179,"width":460,"height":90,"color":"3"},
		{"id":"db695ba3a9bcd64d","type":"text","text":"When the standard works technically but does not plausibly create the intended change","x":7260,"y":-6069,"width":460,"height":90,"color":"3"},
		{"id":"51bb0aae8d19db4e","type":"text","text":"When Development reveals missing actors, unseen infrastructure, a new control dependency, or materially different stakeholder impacts","x":7260,"y":-5959,"width":460,"height":90,"color":"3"},
		{"id":"97427a401ab09bf3","type":"text","text":"`returns-to` instances\nLaunch and Adoption","x":6920,"y":-5469,"width":280,"height":70,"color":"3"},
		{"id":"46e3aa0719294501","type":"text","text":"When the candidate works but maintenance is too expensive, adoption burden is excessive, stewardship is fragile, or tooling is unsustainable","x":7260,"y":-5849,"width":460,"height":90,"color":"3"},
		{"id":"737c218e4a6aa792","type":"text","text":"When Development has materially altered the development case itself","x":7260,"y":-5739,"width":460,"height":90,"color":"3"},
		{"id":"15eb379737a38a45","type":"text","text":"When adopters cannot understand or implement the standard","x":7260,"y":-5469,"width":460,"height":90,"color":"3"},
		{"id":"9c8c74d5bff55754","type":"text","text":"When adoption reveals specification defects","x":7260,"y":-5359,"width":460,"height":90,"color":"3"},
		{"id":"18b40535d7d5c8d6","type":"text","text":"When new real-world scenarios expose gaps","x":7260,"y":-5249,"width":460,"height":90,"color":"3"},
		{"id":"dd5d79178ce0e990","type":"text","text":"When support or maintenance burden becomes unexpectedly high","x":7260,"y":-5139,"width":460,"height":90,"color":"3"},
		{"id":"3d646b036b1e4d17","type":"text","text":"When new actors, infrastructure, or control relationships emerge","x":7260,"y":-5029,"width":460,"height":90,"color":"3"},
		{"id":"d7ea8c51233da9e3","type":"text","text":"When adoption friction is primarily explanatory rather than structural","x":7260,"y":-4429,"width":460,"height":90,"color":"3"},
		{"id":"3c6358a4affc886b","type":"text","text":"When the standard has launched but evidence is still too thin for meaningful Review","x":7260,"y":-4319,"width":460,"height":90,"color":"3"},
		{"id":"4f2215883f980fa8","type":"text","text":"When harm, incompatibility, governance failure, or major ecosystem change warrants immediate review","x":7260,"y":-4209,"width":460,"height":90,"color":"3"},
		{"id":"cb3591aabc72e2ab","type":"text","text":"When evidence is weak or important perspectives are missing","x":7260,"y":-3939,"width":460,"height":90,"color":"3"},
		{"id":"46a29ccb438fddbd","type":"text","text":"`returns-to` instances\nLaunch and Adoption Outcomes (Phase Gate)","x":6920,"y":-4539,"width":280,"height":70,"color":"3"},
		{"id":"2c210052d8845981","type":"text","text":"When a serious defect requires corrective work before waiting for formal Review","x":7260,"y":-4539,"width":460,"height":90,"color":"3"},
		{"id":"ba32c337f3b89c4e","type":"text","text":"`returns-to` instances\nDevelopment Phase","x":6920,"y":-7329,"width":280,"height":70,"color":"3"},
		{"id":"7c9ddf5557f08e48","type":"text","text":"`returns-to` instances\nDevelopment Outcomes (Phase Gate)","x":6920,"y":-6729,"width":280,"height":70,"color":"3"},
		{"id":"e97bce362bb9b733","type":"text","text":"`returns-to` instances\nReview Outcomes (Gate)","x":6920,"y":-3939,"width":280,"height":70,"color":"3"},
		{"id":"134d910cffdabb90","type":"text","text":"When adoption occurs but expected effects do not","x":7260,"y":-4919,"width":460,"height":90,"color":"3"},
		{"id":"aee1f01f518bf015","type":"text","text":"In exceptional cases, when real-world evidence undermines the original premise","x":7260,"y":-4809,"width":460,"height":90,"color":"3"},
		{"id":"195b1bbe145c275e","type":"text","text":"When real-world evidence remains too thin","x":7260,"y":-3829,"width":460,"height":90,"color":"3"},
		{"id":"6b07612ae2525619","type":"text","text":"When the review reveals that the underlying problem, aim, or intervention requires reframing","x":7260,"y":-3719,"width":460,"height":90,"color":"3"},
		{"id":"e580e80425a92dd2","type":"file","file":"framework/Open Standards Main Map/Phase 4 Review and Update/Lifecycle Decision Record.md","x":4449,"y":-7470,"width":291,"height":75,"color":"2"}
